:80 {
	# API routes -> Django backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Admin panel
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Django static files
	handle /static/* {
		reverse_proxy backend:8000
	}

	# Prometheus metrics endpoint
	handle /metrics {
		reverse_proxy backend:8000
	}

	# Grafana
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Prometheus UI
	handle /prometheus/* {
		reverse_proxy prometheus:9090
	}

	# Everything else -> Frontend
	handle {
		reverse_proxy frontend:5173
	}
}
